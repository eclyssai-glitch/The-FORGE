[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.0156863, 0.0156863, 0.0196078, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=2
